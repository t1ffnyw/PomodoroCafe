{
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://cafe-pomodoro.pomodoro-cafe.workers.dev/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cafe-pomodoro.pomodoro-cafe.workers.dev/api/:path*"
    }
  ]
}
