{
  "name": "cafe-pomodoro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix workers/api run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm --prefix workers/api run deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "npm --prefix workers/api run test",
    "test:all": "npm test && npm run test:api"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.12"
  }
}
