# Copy to .dev.vars for `wrangler dev`. .dev.vars is gitignored.

NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret
# Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SIGNING_SECRET=replace-with-a-long-random-string

# The Vite dev server, which proxies /auth/notion and /api/notion to this Worker.
APP_ORIGIN=http://localhost:5173
NOTION_REDIRECT_URI=http://localhost:8787/auth/notion/callback
